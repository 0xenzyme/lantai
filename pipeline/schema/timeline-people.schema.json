{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history.local/schema/timeline-people.json",
  "title": "History timeline people index contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "people"],
  "properties": {
    "contractVersion": { "const": 1 },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "display", "birthAccuracy", "deathAccuracy", "topicId", "topicTitle"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "display": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "gender": { "enum": ["female", "male", "unknown"] },
          "birth": { "type": "integer" },
          "death": { "type": "integer" },
          "birthAccuracy": { "enum": ["exact", "approx", "disputed", "unknown"] },
          "deathAccuracy": { "enum": ["exact", "approx", "disputed", "unknown"] },
          "topicId": { "type": "string", "minLength": 1 },
          "topicTitle": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
