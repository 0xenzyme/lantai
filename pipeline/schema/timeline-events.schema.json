{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history.local/schema/timeline-events.json",
  "title": "History timeline event index contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "events"],
  "properties": {
    "contractVersion": { "const": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "display", "year", "type", "importance", "catalogs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "display": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "year": { "type": "integer" },
          "endYear": { "type": "integer" },
          "type": {
            "enum": ["military", "political", "rebellion", "institutional", "diplomatic", "cultural"]
          },
          "importance": { "enum": [1, 2, 3] },
          "catalogs": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["military", "history"] }
          }
        }
      }
    }
  }
}
