{
  "name": "history-timeline",
  "private": true,
  "version": "0.1.0",
  "description": "四千年中国历史人物与事件交互时间轴",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xenzyme/lantai.git"
  },
  "homepage": "https://lantai.0xenzyme.dev",
  "bugs": {
    "url": "https://github.com/0xenzyme/lantai/issues"
  },
  "keywords": [
    "history",
    "chinese-history",
    "timeline",
    "visualization"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content": "tsx pipeline/cli.ts",
    "content:check": "tsx pipeline/cli.ts --check",
    "people:check": "tsx pipeline/content-cli.ts people check",
    "people:format": "tsx pipeline/content-cli.ts people format",
    "people:new": "tsx pipeline/content-cli.ts people new",
    "events:check": "tsx pipeline/content-cli.ts events check",
    "events:format": "tsx pipeline/content-cli.ts events format",
    "events:new": "tsx pipeline/content-cli.ts events new",
    "collections:check": "tsx pipeline/content-cli.ts collections check",
    "collections:format": "tsx pipeline/content-cli.ts collections format",
    "collections:new": "tsx pipeline/content-cli.ts collections new",
    "people:production:preflight": "tsx pipeline/people-production.ts preflight",
    "people:production:apply": "tsx pipeline/people-production.ts apply",
    "people:publish:check": "tsx pipeline/people-production.ts publish-check",
    "relations:candidates": "tsx pipeline/relations-report.ts",
    "people:audit": "tsx pipeline/audit-people.ts",
    "people:suggest-events": "tsx pipeline/suggest-experiences.ts",
    "events:production:preflight": "tsx pipeline/event-production.ts preflight",
    "events:production:apply": "tsx pipeline/event-production.ts apply",
    "events:publish:check": "tsx pipeline/event-production.ts publish-check",
    "events:migration:check": "tsx pipeline/events-migration.ts check",
    "events:migration:write": "tsx pipeline/events-migration.ts write",
    "build": "tsc --noEmit && tsc --noEmit -p pipeline/tsconfig.json && tsx pipeline/content-cli.ts people check && tsx pipeline/content-cli.ts events check && tsx pipeline/content-cli.ts collections check && tsx pipeline/cli.ts --check && vite build && tsx scripts/prerender.mjs",
    "test": "tsc --noEmit -p tests/tsconfig.json && tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "preview": "vite preview",
    "docs:screenshots": "node scripts/docs-screenshots.mjs"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "yaml": "^2.9.1"
  }
}
